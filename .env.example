# ============================================================
# CPMS Backend - Environment Configuration Template
# Copy this file to ".env" and adjust values for your environment.
# ============================================================

# --- Application identity ---
APP_NAME=Centralized Patch Management System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=True

# --- Server binding ---
HOST=0.0.0.0
PORT=8000

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_FILE=application.log

# --- CORS ---
CORS_ORIGINS=*

# --- Repository storage (used by later tickets: REP-001/REP-002) ---
REPOSITORY_DIR=repository

# --- Database (CPM-002) ---
# Prototype default: local SQLite file, resolved relative to the project root.
DATABASE_URL=sqlite:///./cpms.db
# Set to True to log every SQL statement (useful for debugging).
DATABASE_ECHO=False

# --- Administrator authentication (CPM-003) ---
SESSION_COOKIE_NAME=session
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
# Sessions expire after this many minutes of inactivity (NFR-028);
# each authenticated request resets the countdown.
SESSION_INACTIVITY_TIMEOUT_MINUTES=30
# MUST be set to True once the server is deployed behind HTTPS (see the
# comment on Settings.SESSION_COOKIE_SECURE in backend/core/config.py for
# why the default is False for this HTTP-only prototype).
SESSION_COOKIE_SECURE=False
